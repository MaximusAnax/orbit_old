# Orbit configuration. Copy to .env and edit. Never commit .env.
# Defaults are the safest possible: paper mode, demo endpoints, no trading.

# ---------------------------------------------------------------------------
# Mode. All three must be set to trade real money.
# ---------------------------------------------------------------------------
ORBIT_MODE=paper                    # paper | live | backtest
ORBIT_TRADING_ENABLED=false         # second switch
ORBIT_USE_DEMO_ENDPOINTS=true       # third switch: Kalshi demo environment

ORBIT_BANKROLL_USD=5000

# ---------------------------------------------------------------------------
# Kalshi. Generate an API key in your account settings; you get an RSA private
# key file once, at creation time.
# ---------------------------------------------------------------------------
ORBIT_KALSHI_KEY_ID=
ORBIT_KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem

# ---------------------------------------------------------------------------
# Polymarket. funder is the PROXY WALLET holding USDC, which is usually NOT
# the address derived from the private key. Getting this wrong produces orders
# that sign correctly and then fail on collateral.
# API credentials are derived automatically from the key if left blank.
# ---------------------------------------------------------------------------
ORBIT_POLYMARKET_PRIVATE_KEY=
ORBIT_POLYMARKET_FUNDER_ADDRESS=
ORBIT_POLYMARKET_SIGNATURE_TYPE=1   # 1 proxy, 0 EOA, 2 gnosis safe
ORBIT_POLYMARKET_API_KEY=
ORBIT_POLYMARKET_API_SECRET=
ORBIT_POLYMARKET_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# Data. The archive is the most valuable thing this system builds.
# ---------------------------------------------------------------------------
ORBIT_DATA_DIR=./data
ORBIT_RECORD_INTERVAL_S=5
ORBIT_MAX_MARKETS_PER_VENUE=250

# ---------------------------------------------------------------------------
# Risk. Fractions of bankroll. Tighten rather than loosen.
# ---------------------------------------------------------------------------
ORBIT_MAX_DEPLOYED_FRACTION=0.60
ORBIT_MAX_MARKET_FRACTION=0.10
ORBIT_MAX_EVENT_FRACTION=0.20
ORBIT_MAX_DAILY_LOSS_FRACTION=0.05
ORBIT_MAX_DRAWDOWN_FRACTION=0.15
ORBIT_MAX_ORDERS_PER_MINUTE=60
ORBIT_KELLY_FRACTION=0.25           # rejected above 0.5
ORBIT_MIN_ORDER_SIZE=5              # below this, fees exceed the edge

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------
ORBIT_SCAN_INTERVAL_S=2
ORBIT_MIN_PROFIT_CENTS=1.0          # guaranteed profit per trade, after fees
ORBIT_MAX_CONTRACTS_PER_TRADE=500

# ---------------------------------------------------------------------------
# Dashboard. Required for live trading, or the kill switch is unauthenticated.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
ORBIT_API_HOST=127.0.0.1
ORBIT_API_PORT=8080
ORBIT_API_TOKEN=

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
ORBIT_TELEGRAM_BOT_TOKEN=
ORBIT_TELEGRAM_CHAT_ID=
ORBIT_ALERT_EMAIL=
ORBIT_SMTP_HOST=
ORBIT_SMTP_PORT=587
ORBIT_SMTP_USER=
ORBIT_SMTP_PASSWORD=

ORBIT_LOG_LEVEL=INFO
ORBIT_LOG_JSON=false
